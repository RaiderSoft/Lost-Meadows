# Copy this file to .env and fill in your token.
# .env is gitignored — never commit it.
#
# Get your token from: https://dagshub.com/user/settings/tokens
#
# Load before running a training script:
#   source .env                          # bash/zsh (single terminal session)
#   set -a && source .env && set +a      # export all variables

export DAGSHUB_USER_TOKEN=your_dagshub_token_here
