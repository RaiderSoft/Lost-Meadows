# Large installer files
*.sh
Miniconda3-*.sh

# GeoTIFF data files (too large for git)
*.tif
*.tiff
GEE/TIF_Input/*.tif
GEE/TIF_Output/**/*.tif

# Geodatabase files (very large - 2.4 GB)
*.gdb/
Wetlands/*.gdb/
Wetlands/CA_geodatabase_wetlands.gdb/
Wetlands/OR_geodatabase_wetlands.gdb/
Wetlands/*.geojson/
Wetlands/wetlands_PEM_PSS_PFO_bioregion.dbf
Wetlands/wetlands_PEM_PSS_PFO_bioregion.geojson
Wetlands/wetlands_PEM_PSS_PFO_bioregion.shp
Wetlands/wetlands_PEM_PSS_PFO_bioregion.prj
Wetlands/wetlands_PEM_PSS_PFO_bioregion.shx

# Output directories with generated data
GEE/TIF_Output/*/
GEE/TIF_Output/1/
GEE/TIF_Output/2/

# Temporary files
*_temp.tif
dem_*_temp.tif
sca_*_temp.tif
slope_*_temp.tif
twi_*_temp.tif

# Machine learning models (can be large)
*.pkl
*.joblib

# Training data CSVs (can be large)
*training_data*.csv
Wetlands/training_data_*.csv
ModelTraining/training_data_*.csv

# Environment / secrets (never commit)
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
venv/
ENV/
meadow/

# Jupyter Notebook
.ipynb_checkpoints

# VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Logs
*.log

# Compressed files
*.zip
*.tar.gz
*.rar
*.aux.xml
